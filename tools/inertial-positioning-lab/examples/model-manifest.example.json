{
  "schema_version": 1,
  "id": "example-ronin-velocity",
  "name": "Example RoNIN Velocity",
  "version": "1.0.0",
  "runtime": "tflite",
  "model_file": "model.tflite",
  "description": "Replace with the model's real provenance and training configuration.",
  "input": {
    "shape": [1, 200, 6],
    "layout": "NTC",
    "sample_rate_hz": 100,
    "channels": ["gyro_x", "gyro_y", "gyro_z", "accel_x", "accel_y", "accel_z"],
    "dtype": "float32",
    "mean": [0, 0, 0, 0, 0, 0],
    "std": [1, 1, 1, 1, 1, 1]
  },
  "output": {
    "shape": [1, 2],
    "task": "velocity",
    "coordinate_frame": "body",
    "dimensions": 2,
    "unit": "m/s"
  },
  "benchmark": {
    "threads": 2,
    "warmup_runs": 10,
    "stride": 10,
    "max_windows": 5000
  }
}
